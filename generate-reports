#!/bin/bash
set -euo pipefail

# Usage: generate-reports [config-file]
#
# The config file defaults to config.yaml next to this script. Paths in the
# config file are relative to the directory of the config file, and the
# reports are written to the directory "reports" there.

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
REPORT_SCRIPTS="$SCRIPT_DIR/report-scripts"
source "$REPORT_SCRIPTS"/transactions.sh
source "$REPORT_SCRIPTS"/account_mapping.sh
source "$REPORT_SCRIPTS"/checks.sh

config_file="${1:-$SCRIPT_DIR/config.yaml}"
if [ ! -f "$config_file" ]; then
  echo "Error: the config file $config_file does not exist." >&2
  exit 1
fi
cd "$(dirname -- "$config_file")"
config_file=$(basename -- "$config_file")

check_config "$config_file"

date=$(date -I)
seed=$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')

start_of_period=$(     yq   '.start-of-period' "$config_file")
end_of_period=$(       yq     '.end-of-period' "$config_file")
ledger_file=$(         yq            '.ledger' "$config_file")
account_mappings_src=$(yq  '.account-mappings' "$config_file")

# Don't make reports from a ledger with errors
if ! bean-check "$ledger_file"; then
  echo "Error: $ledger_file did not pass bean-check; no reports were generated." >&2
  exit 1
fi
check_account_mappings "$ledger_file" "$account_mappings_src"
check_year_end "$ledger_file" "$start_of_period" "$end_of_period"
check_verification_numbers "$ledger_file" "$start_of_period" "$end_of_period"

lastvernum=$(get_transaction_list "$ledger_file" "$start_of_period" "$end_of_period" | jq 'map(.vernr) | max // 0')

report_dir="reports"
mkdir -p "$report_dir"
cp "$REPORT_SCRIPTS"/report.typ "$REPORT_SCRIPTS"/logo.svg "$report_dir"

# The organisation number and the logo can be set in the config file
typst_inputs=()
organisation_number=$(yq '.organisation-number // ""' "$config_file")
logo=$(               yq               '.logo // ""' "$config_file")
if [ -n "$organisation_number" ]; then
  typst_inputs+=(--input "organisation-number=$organisation_number")
fi
if [ -n "$logo" ]; then
  cp "$logo" "$report_dir"
  typst_inputs+=(--input "logo=$(basename -- "$logo")")
fi

report_config_file=$(mktemp)
trap 'rm -f "$report_config_file"' EXIT

reports=$(yq -r -oj '.["reports-to-generate"] | .[]' "$config_file")
for report in $reports; do
  echo "$report"

  file_path="${report}-${date}_${seed}"
  general_config=$(yq -oj 'with_entries(select(.value | (type != "!!map" and type != "!!seq")))' "$config_file")
  yq -oj ".config.$report // {}" "$config_file" |
    jq --arg output_file "$report_dir/$file_path" --argjson general "$general_config" '. + $general + {"report-output-file": $output_file}' > "$report_config_file"

  typ="$report_dir/$file_path.typ"
  "$REPORT_SCRIPTS"/"$report".sh "$report_config_file" > "$typ"

  typst compile \
    --input "last-verification=$lastvernum" \
    --input "start-of-period=$start_of_period" \
    --input "end-of-period=$end_of_period" \
    "${typst_inputs[@]}" \
    "$typ"
done
